{
	"name": "sass-helper",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"start": "gpuix-fractalsvelte app.ts",
		"shot": "GPUIX_SCREENSHOT=/tmp/sass-helper.png gpuix-fractalsvelte app.ts",
		"test": "gpuix-fractalsvelte test.ts",
		"test:lib": "node --test src/lib",
		"build": "bun build.ts",
		"dmg": "bun build.ts --dmg",
		"typecheck": "tsc --noEmit && svelte-check --diagnostic-sources js,svelte --fail-on-warnings"
	},
	"dependencies": {
		"@fractaldesign/fractalstyler": "^1.6.0",
		"@fractaldesign/gpuix-fractalsvelte": "^0.5.0",
		"postcss": "^8.5.33",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"sass": "^1.108.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3"
	}
}
